# Credential-free optional native pipeline template.
# Review the current project's pipeline contract before using this template.
# The portable installer does not copy this file or start a daemon.

agent: [codex]

ci_timeout: "168h"
step_quiet_warning: "10m"
agent_timeout: "120m"
review_agent_timeout: "120m"
test_agent_timeout: "120m"
session_reuse: true
log_level: info

auto_fix:
  rebase: 3
  lint: 3
  test: 3
  review: 0
  document: 3
  ci: 3

ci:
  rerun_transient: 0
  revalidate_repairs: false

intent:
  enabled: true
  threshold: 0.2
  slack_days: 3

eval:
  capture_provenance: true
  auto_capture: true
  max_cases: 200
  diversified_size: 32

agent_config:
  codex:
    effort: high
